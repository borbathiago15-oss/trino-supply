<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.2" />
    <PackageReference Include="Microsoft.AspNetCore.TestHost" Version="9.0.8" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.InMemory" Version="9.0.8" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.12.0" />
    <PackageReference Include="Testcontainers.PostgreSql" Version="3.10.0" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\Foundation\TrinoSupply.Foundation.Api\TrinoSupply.Foundation.Api.csproj" />
  </ItemGroup>

  <!-- monta a tabela de rotas de verdade no teste, sem subir o app (SEC-A) -->
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <None Update="fixtures\**\*.xlsx" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!--
    SEC-A: RotasProtegidasTests lê a fonte das rotas para conferir que nenhuma
    rota /api nasce sem autorização declarada, e que nenhuma some no caminho.
    Embutir evita depender do diretório de trabalho e garante que o texto
    conferido é o mesmo que foi compilado. `Rotas/*.cs` entra porque o Program.cs
    está sendo recortado em rotas por módulo (ARQ-A) — sem isso o teste passaria
    a conferir cada vez menos, em silêncio.
  -->
  <ItemGroup>
    <EmbeddedResource Include="..\..\Foundation\TrinoSupply.Foundation.Api\Program.cs" LogicalName="rotas.Program.cs" />
    <EmbeddedResource Include="..\..\Foundation\TrinoSupply.Foundation.Api\Rotas\*.cs" LogicalName="rotas.%(Filename).cs" />
    <None Update="fixtures\rotas-da-api.txt" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
