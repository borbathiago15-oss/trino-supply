// ---------------------------------------------------------------------------
// Fase F3 — schema compras: alçadas e aprovação (tradução fiel do DDL).
// O que o Prisma não expressa vive na migration init_alcadas_e_aprovacao:
//   - CHECKs de faixa, nível, vigência, decisão completa e motivo de rejeição;
//   - EXCLUDE USING gist (ex_regra_nivel_vigencia), que impede duas regras do
//     mesmo nível vigentes ao mesmo tempo (exige a extensão btree_gist);
//   - índices parciais ux_instancia_pendente (uma instância PENDENTE por
//     requisição) e ux_etapa_um_aprovador_por_instancia (bloqueio B4).
// Nunca remova essas cláusulas ao regenerar.
// ---------------------------------------------------------------------------

enum StatusInstancia {
  PENDENTE
  APROVADA
  REJEITADA
  INVALIDADA

  @@map("status_instancia")
  @@schema("compras")
}

enum DecisaoEtapa {
  PENDENTE
  APROVADO
  REJEITADO

  @@map("decisao_etapa")
  @@schema("compras")
}

model RegraAlcada {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId       String    @map("tenant_id") @db.Uuid
  nivel          Int       @db.SmallInt
  papelExigido   String    @map("papel_exigido") @db.VarChar(60)
  valorMin       Decimal   @map("valor_min") @db.Decimal(15, 2)
  /// NULL = sem teto (nível topo da alçada).
  valorMax       Decimal?  @map("valor_max") @db.Decimal(15, 2)
  vigenciaInicio DateTime  @map("vigencia_inicio") @db.Date
  vigenciaFim    DateTime? @map("vigencia_fim") @db.Date
  criadoEm       DateTime  @default(now()) @map("criado_em") @db.Timestamptz(6)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  @@map("regra_alcada")
  @@schema("compras")
}

model AprovadorCentroCusto {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId       String    @map("tenant_id") @db.Uuid
  centroCustoId  String    @map("centro_custo_id") @db.Uuid
  usuarioId      String    @map("usuario_id") @db.Uuid
