# Imagem do Worker (relay do Outbox → publisher). Multi-stage. Contexto = raiz do repositório.
FROM mcr.microsoft.com/dotnet/sdk:9.0 AS build
WORKDIR /src
COPY . .
RUN dotnet publish host/Worker -c Release -o /app /p:UseAppHost=false

FROM mcr.microsoft.com/dotnet/aspnet:9.0
WORKDIR /app
COPY --from=build /app .
USER app
ENTRYPOINT ["dotnet", "TrinoSupply.Worker.dll"]
